// ─── BSE Booking System ───
// Prisma 6 schema for MySQL (cPanel)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Admin ───
model Admin {
  id        String   @id @default(cuid()) @db.VarChar(30)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(100)
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("admins")
}

// ─── Service ───
model Service {
  id          String   @id @default(cuid()) @db.VarChar(30)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  active      Boolean  @default(true)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  bookingServices BookingService[]

  @@map("services")
}

// ─── TimeBlock ───
model TimeBlock {
  id          String  @id @default(cuid()) @db.VarChar(30)
  label       String  @db.VarChar(50)
  startTime   String  @map("start_time") @db.VarChar(10)
  endTime     String  @map("end_time") @db.VarChar(10)
  maxBookings Int     @default(5) @map("max_bookings")
  sortOrder   Int     @default(0) @map("sort_order")
  active      Boolean @default(true)

  bookings Booking[]

  @@map("time_blocks")
}

// ─── DayConfig ───
model DayConfig {
  id        String  @id @default(cuid()) @db.VarChar(30)
  dayOfWeek Int     @unique @map("day_of_week")
  isClosed  Boolean @default(false) @map("is_closed")

  @@map("day_configs")
}

// ─── ClosedDate ───
model ClosedDate {
  id     String   @id @default(cuid()) @db.VarChar(30)
  date   DateTime @unique @db.Date
  reason String?  @db.VarChar(200)

  @@map("closed_dates")
}

// ─── Booking ───
model Booking {
  id            String        @id @default(cuid()) @db.VarChar(30)
  bookingCode   String        @unique @map("booking_code") @db.VarChar(20)
  customerName  String        @map("customer_name") @db.VarChar(100)
  customerPhone String        @map("customer_phone") @db.VarChar(20)
  licensePlate  String        @map("license_plate") @db.VarChar(20)
  date          DateTime      @db.Date
  timeBlockId   String        @map("time_block_id") @db.VarChar(30)
  status        BookingStatus @default(PENDING)
  lineUserId    String?       @map("line_user_id") @db.VarChar(100)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  timeBlock       TimeBlock        @relation(fields: [timeBlockId], references: [id])
  bookingServices BookingService[]

  @@index([date, timeBlockId])
  @@index([status])
  @@index([bookingCode])
  @@map("bookings")
}

// ─── BookingService ───
model BookingService {
  id        String @id @default(cuid()) @db.VarChar(30)
  bookingId String @map("booking_id") @db.VarChar(30)
  serviceId String @map("service_id") @db.VarChar(30)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, serviceId])
  @@map("booking_services")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

// ─── NotificationTemplate ───
// Editable LINE notification messages per status
model NotificationTemplate {
  id       String  @id @default(cuid()) @db.VarChar(30)
  trigger  String  @unique @db.VarChar(20) // CONFIRMED, COMPLETED, CANCELLED
  template String  @db.Text // message with {placeholders}
  active   Boolean @default(true)

  @@map("notification_templates")
}
